//@version=6
indicator("Nykuto Signal V12.3 - REV 6/6 + ORB", overlay=true, max_labels_count=500)

// Decision-support only. No broker orders.
// REV score = 6 independent families: momentum, structure, candle, volume, liquidity, level.
// ORB setup stays separate and strict.

// ===== Inputs =====
nyTz = "America/New_York"
orbSession = input.session("0930-1000", "New York Opening Range")
tradeSession = input.session("1000-1200", "ORB trade window")

rsiLen = input.int(14, "RSI", minval=2)
atrLen = input.int(14, "ATR", minval=2)
volLen = input.int(20, "Volume average", minval=2)
fastLen = input.int(9, "EMA fast", minval=1)
slowLen = input.int(21, "EMA slow", minval=2)
htf = input.timeframe("60", "Context HTF")
htfFastLen = input.int(20, "HTF EMA fast", minval=1)
htfSlowLen = input.int(50, "HTF EMA slow", minval=2)

pivotLeft = input.int(2, "Pivot left", minval=1)
pivotRight = input.int(2, "Pivot right", minval=1)
contextBars = input.int(12, "Context memory bars", minval=1)
ctxCooldown = input.int(6, "B/S cooldown", minval=1)
revCooldown = input.int(4, "REV cooldown", minval=1)
minRevScore = input.int(2, "Minimum REV score", minval=1, maxval=6)

sweepLookback = input.int(8, "Liquidity sweep lookback", minval=2)
levelAtrDistance = input.float(0.35, "Near-level distance ATR", step=0.05)
relVolMin = input.float(1.20, "Relative volume min", step=0.05)

maxRetestMinutes = input.int(5, "ORB retest max minutes", minval=1, maxval=30)
retestToleranceAtr = input.float(0.15, "ORB retest tolerance ATR", step=0.05)
compactOrbAtr = input.float(3.0, "Compact ORB ATR bonus", step=0.1)

showRev = input.bool(true, "Show REV score")
showContextSignals = input.bool(true, "Show B/S context")
showContextMarkers = input.bool(true, "Show R / DIV / MSS")
showOrbSignals = input.bool(true, "Show ORB B/S")
showOrb = input.bool(true, "Show ORB High/Low")
showGuides = input.bool(false, "Show EMA/VWAP")
showTooltips = input.bool(true, "Tooltips")

// ===== Base =====
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
atrRef = atr[1]
vwap = ta.vwap(hlc3)
volAvg = ta.sma(volume, volLen)[1]
relVol = not na(volAvg) and volAvg > 0 ? volume / volAvg : 0.0
volumeOk = relVol >= relVolMin
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

htfFast = request.security(syminfo.tickerid, htf, ta.ema(close, htfFastLen)[1], barmerge.gaps_off, barmerge.lookahead_on)
htfSlow = request.security(syminfo.tickerid, htf, ta.ema(close, htfSlowLen)[1], barmerge.gaps_off, barmerge.lookahead_on)
htfBull = htfFast > htfSlow
htfBear = htfFast < htfSlow

// ===== Candle anatomy =====
barRange = high - low
body = math.abs(close - open)
bodyRatio = barRange > 0 ? body / barRange : 0.0
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
upperWickRatio = barRange > 0 ? upperWick / barRange : 0.0
lowerWickRatio = barRange > 0 ? lowerWick / barRange : 0.0

expansion = not na(atrRef) and atrRef > 0 and barRange >= atrRef * 0.75
displacementUp = expansion and bodyRatio >= 0.60 and close > open
displacementDown = expansion and bodyRatio >= 0.60 and close < open

bullEngulf = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bearEngulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
bullHammer = lowerWickRatio >= 0.50 and upperWickRatio <= 0.20 and bodyRatio <= 0.45
bearStar = upperWickRatio >= 0.50 and lowerWickRatio <= 0.20 and bodyRatio <= 0.45
bullPin = lowerWickRatio >= 0.60 and bodyRatio <= 0.30
bearPin = upperWickRatio >= 0.60 and bodyRatio <= 0.30
bullCandle = bullEngulf or bullHammer or bullPin
bearCandle = bearEngulf or bearStar or bearPin

bullAbsorption = volumeOk and lowerWickRatio >= 0.45 and bodyRatio <= 0.35
bearAbsorption = volumeOk and upperWickRatio >= 0.45 and bodyRatio <= 0.35

// ===== RSI recovery =====
rsiExitUp = barstate.isconfirmed and ta.crossover(rsi, 30)
rsiExitDown = barstate.isconfirmed and ta.crossunder(rsi, 70)
ageRsiUp = ta.barssince(rsiExitUp)
ageRsiDown = ta.barssince(rsiExitDown)
recentRsiUp = not na(ageRsiUp) and ageRsiUp <= contextBars
recentRsiDown = not na(ageRsiDown) and ageRsiDown <= contextBars

// ===== Confirmed pivots + divergence =====
pHigh = ta.pivothigh(high, pivotLeft, pivotRight)
pLow = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastHigh = na
var float prevHigh = na
var float lastLow = na
var float prevLow = na
var float lastHighRsi = na
var float lastLowRsi = na

bullDiv = false
bearDiv = false

if barstate.isconfirmed and not na(pLow)
    pivotRsiLow = rsi[pivotRight]
    bullDiv := not na(lastLow) and not na(lastLowRsi) and pLow < lastLow and pivotRsiLow > lastLowRsi
    prevLow := lastLow
    lastLow := pLow
    lastLowRsi := pivotRsiLow

if barstate.isconfirmed and not na(pHigh)
    pivotRsiHigh = rsi[pivotRight]
    bearDiv := not na(lastHigh) and not na(lastHighRsi) and pHigh > lastHigh and pivotRsiHigh < lastHighRsi
    prevHigh := lastHigh
    lastHigh := pHigh
    lastHighRsi := pivotRsiHigh

ageBullDiv = ta.barssince(bullDiv)
ageBearDiv = ta.barssince(bearDiv)
recentBullDiv = not na(ageBullDiv) and ageBullDiv <= contextBars
recentBearDiv = not na(ageBearDiv) and ageBearDiv <= contextBars

// ===== Structure =====
higherHigh = not na(lastHigh) and not na(prevHigh) and lastHigh > prevHigh
lowerHigh = not na(lastHigh) and not na(prevHigh) and lastHigh < prevHigh
higherLow = not na(lastLow) and not na(prevLow) and lastLow > prevLow
lowerLow = not na(lastLow) and not na(prevLow) and lastLow < prevLow

bullStructure = higherHigh and higherLow
bearStructure = lowerHigh and lowerLow

bullBreak = not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
bearBreak = not na(lastLow) and close < lastLow and close[1] >= lastLow

bullBOS = barstate.isconfirmed and bullStructure and bullBreak
bearBOS = barstate.isconfirmed and bearStructure and bearBreak
bullMSS = barstate.isconfirmed and bearStructure and bullBreak and displacementUp and volumeOk
bearMSS = barstate.isconfirmed and bullStructure and bearBreak and displacementDown and volumeOk

// ===== ORB state =====
inOrb = not na(time(timeframe.period, orbSession, nyTz))
inTradeWindow = not na(time(timeframe.period, tradeSession, nyTz))
orbStart = inOrb and not inOrb[1]
orbEnd = not inOrb and inOrb[1]

var float orbHigh = na
var float orbLow = na
var float orbAtrAtEnd = na
var bool orbReady = false

if orbStart
    orbHigh := high
    orbLow := low
    orbAtrAtEnd := na
    orbReady := false
else if inOrb
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow := na(orbLow) ? low : math.min(orbLow, low)

if orbEnd
    orbAtrAtEnd := atrRef
    orbReady := true

orbWidth = orbReady and not na(orbHigh) and not na(orbLow) ? orbHigh - orbLow : na
orbAtrRatio = orbReady and not na(orbWidth) and not na(orbAtrAtEnd) and orbAtrAtEnd > 0 ? orbWidth / orbAtrAtEnd : na
compactOrb = not na(orbAtrRatio) and orbAtrRatio <= compactOrbAtr

// ===== Liquidity sweeps =====
priorLow = ta.lowest(low[1], sweepLookback)
priorHigh = ta.highest(high[1], sweepLookback)
bullSweep = barstate.isconfirmed and low < priorLow and close > priorLow
bearSweep = barstate.isconfirmed and high > priorHigh and close < priorHigh

// ===== Level proximity =====
nearVwap = not na(atrRef) and atrRef > 0 and math.abs(close - vwap) <= atrRef * levelAtrDistance
nearSwingLow = not na(lastLow) and not na(atrRef) and atrRef > 0 and math.abs(close - lastLow) <= atrRef * levelAtrDistance
nearSwingHigh = not na(lastHigh) and not na(atrRef) and atrRef > 0 and math.abs(close - lastHigh) <= atrRef * levelAtrDistance
nearOrbLow = orbReady and not na(orbLow) and not na(atrRef) and atrRef > 0 and math.abs(close - orbLow) <= atrRef * levelAtrDistance
nearOrbHigh = orbReady and not na(orbHigh) and not na(atrRef) and atrRef > 0 and math.abs(close - orbHigh) <= atrRef * levelAtrDistance

bullLevel = nearVwap or nearSwingLow or nearOrbLow
bearLevel = nearVwap or nearSwingHigh or nearOrbHigh

// ===== REV 6/6 families =====
// 1 Momentum
bullMomentumTurn = recentRsiUp or recentBullDiv or (macdHist > macdHist[1] and macdHist[1] <= macdHist[2])
bearMomentumTurn = recentRsiDown or recentBearDiv or (macdHist < macdHist[1] and macdHist[1] >= macdHist[2])

// 2 Structure
bullStructureTurn = bullMSS or bullBOS or higherLow
bearStructureTurn = bearMSS or bearBOS or lowerHigh

// 3 Candle
bullCandleTurn = bullCandle
bearCandleTurn = bearCandle

// 4 Volume
bullVolumeTurn = volumeOk and (close > open or bullAbsorption)
bearVolumeTurn = volumeOk and (close < open or bearAbsorption)

// 5 Liquidity
bullLiquidityTurn = bullSweep
bearLiquidityTurn = bearSweep

// 6 Level
bullLevelTurn = bullLevel
bearLevelTurn = bearLevel

bullRevScore =
     (bullMomentumTurn ? 1 : 0) +
     (bullStructureTurn ? 1 : 0) +
     (bullCandleTurn ? 1 : 0) +
     (bullVolumeTurn ? 1 : 0) +
     (bullLiquidityTurn ? 1 : 0) +
     (bullLevelTurn ? 1 : 0)

bearRevScore =
     (bearMomentumTurn ? 1 : 0) +
     (bearStructureTurn ? 1 : 0) +
     (bearCandleTurn ? 1 : 0) +
     (bearVolumeTurn ? 1 : 0) +
     (bearLiquidityTurn ? 1 : 0) +
     (bearLevelTurn ? 1 : 0)

// Trigger only when score improves or a fresh reversal event appears.
bullRevEvent = rsiExitUp or bullDiv or bullMSS or bullSweep or bullCandle
bearRevEvent = rsiExitDown or bearDiv or bearMSS or bearSweep or bearCandle

var int lastBullRev = na
var int lastBearRev = na

bullRevRaw = barstate.isconfirmed and bullRevScore >= minRevScore and (bullRevScore > bullRevScore[1] or bullRevEvent)
bearRevRaw = barstate.isconfirmed and bearRevScore >= minRevScore and (bearRevScore > bearRevScore[1] or bearRevEvent)

bullRev = bullRevRaw and (na(lastBullRev) or bar_index - lastBullRev >= revCooldown)
bearRev = bearRevRaw and (na(lastBearRev) or bar_index - lastBearRev >= revCooldown)

if bullRev
    lastBullRev := bar_index
if bearRev
    lastBearRev := bar_index

bullRevName = bullRevScore >= 5 ? "REV++" : bullRevScore >= 4 ? "REV+" : "REV"
bearRevName = bearRevScore >= 5 ? "REV++" : bearRevScore >= 4 ? "REV+" : "REV"

bullRevText = bullRevName + "↑ " + str.tostring(bullRevScore) + "/6"
bearRevText = bearRevName + "↓ " + str.tostring(bearRevScore) + "/6"

bullRevTip =
     "REV haussier " + str.tostring(bullRevScore) + "/6\n" +
     "Momentum: " + (bullMomentumTurn ? "✓" : "✗") + "\n" +
     "Structure: " + (bullStructureTurn ? "✓" : "✗") + "\n" +
     "Bougie: " + (bullCandleTurn ? "✓" : "✗") + "\n" +
     "Volume: " + (bullVolumeTurn ? "✓" : "✗") + "\n" +
     "Liquidite: " + (bullLiquidityTurn ? "✓" : "✗") + "\n" +
     "Niveau: " + (bullLevelTurn ? "✓" : "✗") + "\n\n" +
     "Alerte de retournement, pas ordre automatique."

bearRevTip =
     "REV baissier " + str.tostring(bearRevScore) + "/6\n" +
     "Momentum: " + (bearMomentumTurn ? "✓" : "✗") + "\n" +
     "Structure: " + (bearStructureTurn ? "✓" : "✗") + "\n" +
     "Bougie: " + (bearCandleTurn ? "✓" : "✗") + "\n" +
     "Volume: " + (bearVolumeTurn ? "✓" : "✗") + "\n" +
     "Liquidite: " + (bearLiquidityTurn ? "✓" : "✗") + "\n" +
     "Niveau: " + (bearLevelTurn ? "✓" : "✗") + "\n\n" +
     "Alerte de retournement, pas ordre automatique."

// ===== Directional B/S context =====
localBull = emaFast > emaSlow and emaSlow >= emaSlow[1]
localBear = emaFast < emaSlow and emaSlow <= emaSlow[1]
buyVwap = close > vwap
sellVwap = close < vwap
buyMomentum = rsi > 55 and rsi > rsi[1] and macdHist > macdHist[1]
sellMomentum = rsi < 45 and rsi < rsi[1] and macdHist < macdHist[1]

recentHigh6 = ta.highest(high[1], 6)
recentLow6 = ta.lowest(low[1], 6)
breakoutUp = close > recentHigh6 and close > open
breakdownDown = close < recentLow6 and close < open

contextBuyScore =
     (localBull ? 2 : 0) +
     (htfBull ? 2 : 0) +
     (buyVwap ? 1 : 0) +
     (buyMomentum ? 1 : 0) +
     (volumeOk ? 1 : 0) +
     (displacementUp ? 1 : 0) +
     (higherHigh ? 1 : 0) +
     (higherLow ? 1 : 0) +
     (bullBOS ? 2 : 0) +
     (bullCandle ? 1 : 0) +
     (recentRsiUp ? 1 : 0) +
     (recentBullDiv ? 1 : 0)

contextSellScore =
     (localBear ? 2 : 0) +
     (htfBear ? 2 : 0) +
     (sellVwap ? 1 : 0) +
     (sellMomentum ? 1 : 0) +
     (volumeOk ? 1 : 0) +
     (displacementDown ? 1 : 0) +
     (lowerHigh ? 1 : 0) +
     (lowerLow ? 1 : 0) +
     (bearBOS ? 2 : 0) +
     (bearCandle ? 1 : 0) +
     (recentRsiDown ? 1 : 0) +
     (recentBearDiv ? 1 : 0)

rawContextBuy = barstate.isconfirmed and (breakoutUp or bullEngulf or bullBOS) and contextBuyScore >= 6 and rsi < 75
rawContextSell = barstate.isconfirmed and (breakdownDown or bearEngulf or bearBOS) and contextSellScore >= 6 and rsi > 25

var int lastContextBuy = na
var int lastContextSell = na
contextBuy = rawContextBuy and (na(lastContextBuy) or bar_index - lastContextBuy >= ctxCooldown)
contextSell = rawContextSell and (na(lastContextSell) or bar_index - lastContextSell >= ctxCooldown)

if contextBuy
    lastContextBuy := bar_index
if contextSell
    lastContextSell := bar_index

ctxBuyLabel = contextBuyScore >= 11 ? "B++" : contextBuyScore >= 8 ? "B+" : "B"
ctxSellLabel = contextSellScore >= 11 ? "S++" : contextSellScore >= 8 ? "S+" : "S"

ctxBuyTip = "Contexte haussier\nScore: " + str.tostring(contextBuyScore) + "\nRSI: " + str.tostring(rsi, "#.0") + "\nRelVol: " + str.tostring(relVol, "#.00") + "x"
ctxSellTip = "Contexte baissier\nScore: " + str.tostring(contextSellScore) + "\nRSI: " + str.tostring(rsi, "#.0") + "\nRelVol: " + str.tostring(relVol, "#.00") + "x"

// ===== Strict ORB + RSI + fast retest =====
longBreak = orbReady and inTradeWindow and barstate.isconfirmed and close > orbHigh and close[1] <= orbHigh
shortBreak = orbReady and inTradeWindow and barstate.isconfirmed and close < orbLow and close[1] >= orbLow

var int longBreakTime = na
var int shortBreakTime = na
var bool longArmed = false
var bool shortArmed = false

if orbStart
    longBreakTime := na
    shortBreakTime := na
    longArmed := false
    shortArmed := false

if longBreak
    longBreakTime := time_close
    longArmed := true
    shortArmed := false

if shortBreak
    shortBreakTime := time_close
    shortArmed := true
    longArmed := false

maxRetestMs = maxRetestMinutes * 60 * 1000
longStillFast = longArmed and not na(longBreakTime) and time_close - longBreakTime <= maxRetestMs
shortStillFast = shortArmed and not na(shortBreakTime) and time_close - shortBreakTime <= maxRetestMs

if longArmed and not longStillFast
    longArmed := false
if shortArmed and not shortStillFast
    shortArmed := false

tol = not na(atrRef) ? atrRef * retestToleranceAtr : 0.0
longRetest = longStillFast and low <= orbHigh + tol and close >= orbHigh and barstate.isconfirmed
shortRetest = shortStillFast and high >= orbLow - tol and close <= orbLow and barstate.isconfirmed

orbLong = longRetest and rsi <= 70
orbShort = shortRetest and rsi >= 30

if longRetest
    longArmed := false
if shortRetest
    shortArmed := false

orbLongBonus = (compactOrb ? 1 : 0) + (volumeOk ? 1 : 0) + (displacementUp ? 1 : 0)
orbShortBonus = (compactOrb ? 1 : 0) + (volumeOk ? 1 : 0) + (displacementDown ? 1 : 0)

orbLongLabel = orbLongBonus >= 2 ? "ORB B++" : orbLongBonus == 1 ? "ORB B+" : "ORB B"
orbShortLabel = orbShortBonus >= 2 ? "ORB S++" : orbShortBonus == 1 ? "ORB S+" : "ORB S"

orbLongTip = "SETUP ORB LONG\nCassure + retest <= " + str.tostring(maxRetestMinutes) + " min\nRSI: " + str.tostring(rsi, "#.0") + " <= 70\nORB/ATR: " + (na(orbAtrRatio) ? "n/a" : str.tostring(orbAtrRatio, "#.00"))
orbShortTip = "SETUP ORB SHORT\nCassure + retest <= " + str.tostring(maxRetestMinutes) + " min\nRSI: " + str.tostring(rsi, "#.0") + " >= 30\nORB/ATR: " + (na(orbAtrRatio) ? "n/a" : str.tostring(orbAtrRatio, "#.00"))

// ===== REV labels =====
if showRev and bullRev
    label.new(bar_index, low, bullRevText, style=label.style_label_up, color=color.new(color.aqua, bullRevScore >= 5 ? 15 : 55), textcolor=color.black, size=bullRevScore >= 5 ? size.small : size.tiny, tooltip=showTooltips ? bullRevTip : "")

if showRev and bearRev
    label.new(bar_index, high, bearRevText, style=label.style_label_down, color=color.new(color.orange, bearRevScore >= 5 ? 15 : 55), textcolor=color.black, size=bearRevScore >= 5 ? size.small : size.tiny, tooltip=showTooltips ? bearRevTip : "")

// ===== Existing context markers =====
if showContextMarkers and rsiExitUp
    label.new(bar_index, low, "R↑", style=label.style_label_up, color=color.new(color.green, 100), textcolor=color.lime, size=size.tiny, tooltip="RSI exits oversold")
if showContextMarkers and rsiExitDown
    label.new(bar_index, high, "R↓", style=label.style_label_down, color=color.new(color.red, 100), textcolor=color.red, size=size.tiny, tooltip="RSI exits overbought")
if showContextMarkers and bullDiv
    label.new(bar_index, low, "DIV↑", style=label.style_label_up, color=color.new(color.aqua, 100), textcolor=color.aqua, size=size.tiny, tooltip="Bullish RSI divergence")
if showContextMarkers and bearDiv
    label.new(bar_index, high, "DIV↓", style=label.style_label_down, color=color.new(color.orange, 100), textcolor=color.orange, size=size.tiny, tooltip="Bearish RSI divergence")
if showContextMarkers and bullMSS
    label.new(bar_index, low, "MSS↑", style=label.style_label_up, color=color.new(color.aqua, 15), textcolor=color.black, size=size.tiny, tooltip="Bullish market structure shift")
if showContextMarkers and bearMSS
    label.new(bar_index, high, "MSS↓", style=label.style_label_down, color=color.new(color.orange, 15), textcolor=color.black, size=size.tiny, tooltip="Bearish market structure shift")

// ===== B/S context labels =====
if showContextSignals and contextBuy
    label.new(bar_index, low, ctxBuyLabel, style=label.style_label_up, color=color.new(color.green, 72), textcolor=color.white, size=contextBuyScore >= 11 ? size.small : size.tiny, tooltip=showTooltips ? ctxBuyTip : "")
if showContextSignals and contextSell
    label.new(bar_index, high, ctxSellLabel, style=label.style_label_down, color=color.new(color.red, 72), textcolor=color.white, size=contextSellScore >= 11 ? size.small : size.tiny, tooltip=showTooltips ? ctxSellTip : "")

// ===== ORB labels =====
if showOrbSignals and orbLong
    label.new(bar_index, low, orbLongLabel, style=label.style_label_up, color=color.new(color.lime, 15), textcolor=color.black, size=orbLongBonus >= 2 ? size.small : size.tiny, tooltip=showTooltips ? orbLongTip : "")
if showOrbSignals and orbShort
    label.new(bar_index, high, orbShortLabel, style=label.style_label_down, color=color.new(color.red, 15), textcolor=color.white, size=orbShortBonus >= 2 ? size.small : size.tiny, tooltip=showTooltips ? orbShortTip : "")

// ===== Guides =====
plot(showOrb and orbReady ? orbHigh : na, "ORB High", color=color.new(color.green, 55), linewidth=1, style=plot.style_linebr)
plot(showOrb and orbReady ? orbLow : na, "ORB Low", color=color.new(color.red, 55), linewidth=1, style=plot.style_linebr)
plot(showGuides ? emaFast : na, "EMA 9", color=color.new(color.blue, 40))
plot(showGuides ? emaSlow : na, "EMA 21", color=color.new(color.orange, 40))
plot(showGuides ? vwap : na, "VWAP", color=color.new(color.purple, 40))

// ===== Alerts =====
alertcondition(bullRev, title="Nykuto V12.3 REV UP", message="Nykuto V12.3 bullish REV score fired. Decision-support only.")
alertcondition(bearRev, title="Nykuto V12.3 REV DOWN", message="Nykuto V12.3 bearish REV score fired. Decision-support only.")
alertcondition(contextBuy, title="Nykuto V12.3 Context BUY", message="Nykuto V12.3 contextual BUY.")
alertcondition(contextSell, title="Nykuto V12.3 Context SELL", message="Nykuto V12.3 contextual SELL.")
alertcondition(orbLong, title="Nykuto V12.3 ORB BUY", message="Nykuto V12.3 strict ORB BUY candidate.")
alertcondition(orbShort, title="Nykuto V12.3 ORB SELL", message="Nykuto V12.3 strict ORB SELL candidate.")
