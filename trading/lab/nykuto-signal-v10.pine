//@version=6
indicator("Nykuto Signal V10 - Selective Confluence", overlay=true, max_labels_count=500)

// Research indicator only. No broker orders.
// V10 keeps the chart minimal: candle/volume intelligence reinforces existing markers instead of adding new ones.

// ===== Inputs =====
fastLen = input.int(9, "EMA rapide", minval=1)
slowLen = input.int(21, "EMA lente", minval=2)
rsiLen = input.int(14, "RSI", minval=2)
atrLen = input.int(14, "ATR", minval=2)
volLen = input.int(20, "Volume moyen", minval=2)
pivotLeft = input.int(2, "Pivot gauche", minval=1)
pivotRight = input.int(2, "Pivot droite", minval=1)
useAutoHtf = input.bool(true, "HTF automatique")
manualHtf = input.timeframe("60", "HTF manuel")
htfFastLen = input.int(20, "HTF EMA rapide", minval=1)
htfSlowLen = input.int(50, "HTF EMA lente", minval=2)
relVolMin = input.float(1.20, "Volume relatif min", step=0.05)
relVolHigh = input.float(1.50, "Volume eleve", step=0.05)
relVolExtreme = input.float(2.00, "Volume exceptionnel", step=0.10)
rangeATRMin = input.float(0.75, "Expansion min ATR", step=0.05)
maxExtensionATR = input.float(1.40, "Extension max EMA/ATR", step=0.10)
contextBars = input.int(12, "Memoire RSI/divergence", minval=1)
cooldownBars = input.int(6, "Cooldown", minval=1)
continuationStrong = input.int(10, "Seuil B+/S+", minval=1)
continuationVeryStrong = input.int(13, "Seuil B++/S++", minval=2)
reversalStrong = input.int(8, "Seuil BR/SR", minval=1)
reversalVeryStrong = input.int(11, "Seuil BR+/SR+", minval=2)
showContext = input.bool(true, "Afficher R/DIV/MSS")
showSessions = input.bool(true, "Afficher TOK/LON/NY")
showGuides = input.bool(false, "Afficher EMA/VWAP")
showTooltips = input.bool(true, "Explications au survol")

// ===== Helpers =====
f_mark(bool cond, string txt) => cond ? "OK " + txt + "\n" : ""

f_tip(string title, int score, string details) =>
    showTooltips ? title + "\nScore: " + str.tostring(score) + "\n\n" + details : ""

// ===== Auto higher timeframe =====
chartSec = timeframe.in_seconds()
autoHtf = chartSec <= 15 ? "1" : chartSec <= 60 ? "5" : chartSec <= 300 ? "15" : chartSec <= 900 ? "60" : chartSec <= 3600 ? "240" : "D"
htf = useAutoHtf ? autoHtf : manualHtf

// ===== Base =====
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
atrRef = atr[1]
vwap = ta.vwap(hlc3)
volAvg = ta.sma(volume, volLen)[1]
relVol = not na(volAvg) and volAvg > 0 ? volume / volAvg : 0.0
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

// ===== Confirmed higher timeframe =====
htfFast = request.security(syminfo.tickerid, htf, ta.ema(close, htfFastLen)[1], barmerge.gaps_off, barmerge.lookahead_on)
htfSlow = request.security(syminfo.tickerid, htf, ta.ema(close, htfSlowLen)[1], barmerge.gaps_off, barmerge.lookahead_on)
htfBull = htfFast > htfSlow
htfBear = htfFast < htfSlow

// ===== Candle anatomy =====
candleRange = high - low
body = math.abs(close - open)
bodyRatio = candleRange > 0 ? body / candleRange : 0.0
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
upperWickRatio = candleRange > 0 ? upperWick / candleRange : 0.0
lowerWickRatio = candleRange > 0 ? lowerWick / candleRange : 0.0

expansion = not na(atrRef) and atrRef > 0 and candleRange >= atrRef * rangeATRMin
displacementUp = expansion and bodyRatio >= 0.60 and close > open
displacementDown = expansion and bodyRatio >= 0.60 and close < open
doji = bodyRatio <= 0.10

// ===== Volume intelligence =====
volumeOk = relVol >= relVolMin
volumeHigh = relVol >= relVolHigh
volumeExtreme = relVol >= relVolExtreme

// ===== Candle patterns =====
bullEngulf = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bearEngulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]

bullHammer = lowerWickRatio >= 0.50 and upperWickRatio <= 0.20 and bodyRatio <= 0.45
bearShootingStar = upperWickRatio >= 0.50 and lowerWickRatio <= 0.20 and bodyRatio <= 0.45
bullPin = lowerWickRatio >= 0.60 and bodyRatio <= 0.30
bearPin = upperWickRatio >= 0.60 and bodyRatio <= 0.30

bullReject = low <= emaFast and close > emaFast and close > open and close > high[1]
bearReject = high >= emaFast and close < emaFast and close < open and close < low[1]

bullPattern = bullEngulf or bullHammer or bullPin or bullReject
bearPattern = bearEngulf or bearShootingStar or bearPin or bearReject

// Potential absorption: high volume, small body, directional rejection wick.
bullAbsorption = volumeHigh and bodyRatio <= 0.35 and lowerWickRatio >= 0.45
bearAbsorption = volumeHigh and bodyRatio <= 0.35 and upperWickRatio >= 0.45

// ===== RSI events =====
rsiExitUp = barstate.isconfirmed and ta.crossover(rsi, 30)
rsiExitDown = barstate.isconfirmed and ta.crossunder(rsi, 70)
ageRsiUp = ta.barssince(rsiExitUp)
ageRsiDown = ta.barssince(rsiExitDown)
recentRsiUp = not na(ageRsiUp) and ageRsiUp <= contextBars
recentRsiDown = not na(ageRsiDown) and ageRsiDown <= contextBars

// ===== Confirmed pivots + divergence =====
pHigh = ta.pivothigh(high, pivotLeft, pivotRight)
pLow = ta.pivotlow(low, pivotLeft, pivotRight)
var float lastHigh = na
var float prevHigh = na
var float lastLow = na
var float prevLow = na
var float lastHighRsi = na
var float lastLowRsi = na
bullDiv = false
bearDiv = false

if barstate.isconfirmed and not na(pLow)
    pivotRsi = rsi[pivotRight]
    bullDiv := not na(lastLow) and not na(lastLowRsi) and pLow < lastLow and pivotRsi > lastLowRsi
    prevLow := lastLow
    lastLow := pLow
    lastLowRsi := pivotRsi

if barstate.isconfirmed and not na(pHigh)
    pivotRsi = rsi[pivotRight]
    bearDiv := not na(lastHigh) and not na(lastHighRsi) and pHigh > lastHigh and pivotRsi < lastHighRsi
    prevHigh := lastHigh
    lastHigh := pHigh
    lastHighRsi := pivotRsi

ageBullDiv = ta.barssince(bullDiv)
ageBearDiv = ta.barssince(bearDiv)
recentBullDiv = not na(ageBullDiv) and ageBullDiv <= contextBars
recentBearDiv = not na(ageBearDiv) and ageBearDiv <= contextBars

// ===== Structure =====
higherHigh = not na(lastHigh) and not na(prevHigh) and lastHigh > prevHigh
lowerHigh = not na(lastHigh) and not na(prevHigh) and lastHigh < prevHigh
higherLow = not na(lastLow) and not na(prevLow) and lastLow > prevLow
lowerLow = not na(lastLow) and not na(prevLow) and lastLow < prevLow
bullStructure = higherHigh and higherLow
bearStructure = lowerHigh and lowerLow

bullBreak = not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
bearBreak = not na(lastLow) and close < lastLow and close[1] >= lastLow
bullBOS = barstate.isconfirmed and bullStructure and bullBreak
bearBOS = barstate.isconfirmed and bearStructure and bearBreak
bullMSS = barstate.isconfirmed and bearStructure and bullBreak and displacementUp and volumeOk
bearMSS = barstate.isconfirmed and bullStructure and bearBreak and displacementDown and volumeOk

// ===== FVG context =====
bullFvg = low > high[2]
bearFvg = high < low[2]

// ===== Trend / momentum =====
localBull = emaFast > emaSlow and emaSlow >= emaSlow[1]
localBear = emaFast < emaSlow and emaSlow <= emaSlow[1]
buyMomentum = rsi > 55 and rsi > rsi[1] and macdHist > macdHist[1]
sellMomentum = rsi < 45 and rsi < rsi[1] and macdHist < macdHist[1]
buyVwap = close > vwap
sellVwap = close < vwap
buyExtensionOk = not na(atrRef) and close >= emaFast and close - emaFast <= atrRef * maxExtensionATR
sellExtensionOk = not na(atrRef) and close <= emaFast and emaFast - close <= atrRef * maxExtensionATR

// Candle pattern only gets credit when context supports its direction.
bullPatternContext = bullPattern and (recentRsiUp or recentBullDiv or higherLow or close > emaFast)
bearPatternContext = bearPattern and (recentRsiDown or recentBearDiv or lowerHigh or close < emaFast)

// ===== Continuation triggers =====
recentHigh6 = ta.highest(high[1], 6)
recentLow6 = ta.lowest(low[1], 6)
breakoutUp = close > recentHigh6 and close > open
breakdownDown = close < recentLow6 and close < open
buyTrigger = breakoutUp or bullEngulf or bullReject
sellTrigger = breakdownDown or bearEngulf or bearReject

// ===== Selective continuation score =====
buyScore = (localBull ? 2 : 0) + (htfBull ? 2 : 0) + (buyVwap ? 1 : 0) + (buyMomentum ? 1 : 0) + (volumeOk ? 1 : 0) + (volumeHigh ? 1 : 0) + (expansion ? 1 : 0) + (higherHigh ? 1 : 0) + (higherLow ? 1 : 0) + (bullFvg ? 1 : 0) + (bullBOS ? 2 : 0) + (bullPatternContext ? 1 : 0) + (displacementUp ? 1 : 0) - (doji ? 1 : 0)
sellScore = (localBear ? 2 : 0) + (htfBear ? 2 : 0) + (sellVwap ? 1 : 0) + (sellMomentum ? 1 : 0) + (volumeOk ? 1 : 0) + (volumeHigh ? 1 : 0) + (expansion ? 1 : 0) + (lowerHigh ? 1 : 0) + (lowerLow ? 1 : 0) + (bearFvg ? 1 : 0) + (bearBOS ? 2 : 0) + (bearPatternContext ? 1 : 0) + (displacementDown ? 1 : 0) - (doji ? 1 : 0)

// More selective than V9: trend + HTF + trigger + either volume or expansion.
rawBuyContinuation = barstate.isconfirmed and localBull and htfBull and buyTrigger and buyExtensionOk and rsi < 70 and (volumeOk or expansion) and buyScore >= continuationStrong
rawSellContinuation = barstate.isconfirmed and localBear and htfBear and sellTrigger and sellExtensionOk and rsi > 30 and (volumeOk or expansion) and sellScore >= continuationStrong

// ===== Reversal score: MSS mandatory =====
buyReversalContext = recentRsiUp or recentBullDiv
sellReversalContext = recentRsiDown or recentBearDiv

buyRevScore = (bullMSS ? 4 : 0) + (recentRsiUp ? 2 : 0) + (recentBullDiv ? 2 : 0) + (rsi > rsi[1] ? 1 : 0) + (macdHist > macdHist[1] ? 1 : 0) + (close > emaFast ? 1 : 0) + (buyVwap ? 1 : 0) + (htfBull ? 1 : 0) + (bullPatternContext ? 2 : 0) + (bullAbsorption ? 1 : 0) + (volumeHigh ? 1 : 0) + (volumeExtreme ? 1 : 0)
sellRevScore = (bearMSS ? 4 : 0) + (recentRsiDown ? 2 : 0) + (recentBearDiv ? 2 : 0) + (rsi < rsi[1] ? 1 : 0) + (macdHist < macdHist[1] ? 1 : 0) + (close < emaFast ? 1 : 0) + (sellVwap ? 1 : 0) + (htfBear ? 1 : 0) + (bearPatternContext ? 2 : 0) + (bearAbsorption ? 1 : 0) + (volumeHigh ? 1 : 0) + (volumeExtreme ? 1 : 0)

rawBuyReversal = bullMSS and buyReversalContext and buyRevScore >= reversalStrong
rawSellReversal = bearMSS and sellReversalContext and sellRevScore >= reversalStrong

// ===== Cooldown =====
var int lastBuyBar = na
var int lastSellBar = na
buyCooldown = na(lastBuyBar) or bar_index - lastBuyBar >= cooldownBars
sellCooldown = na(lastSellBar) or bar_index - lastSellBar >= cooldownBars
buyContinuation = rawBuyContinuation and buyCooldown and not rawBuyContinuation[1]
sellContinuation = rawSellContinuation and sellCooldown and not rawSellContinuation[1]
buyReversal = rawBuyReversal and buyCooldown
sellReversal = rawSellReversal and sellCooldown

if buyContinuation or buyReversal
    lastBuyBar := bar_index
if sellContinuation or sellReversal
    lastSellBar := bar_index

buyStrong = buyContinuation and buyScore >= continuationStrong and buyScore < continuationVeryStrong
buyVeryStrong = buyContinuation and buyScore >= continuationVeryStrong
sellStrong = sellContinuation and sellScore >= continuationStrong and sellScore < continuationVeryStrong
sellVeryStrong = sellContinuation and sellScore >= continuationVeryStrong
buyRevStrong = buyReversal and buyRevScore >= reversalStrong and buyRevScore < reversalVeryStrong
buyRevVeryStrong = buyReversal and buyRevScore >= reversalVeryStrong
sellRevStrong = sellReversal and sellRevScore >= reversalStrong and sellRevScore < reversalVeryStrong
sellRevVeryStrong = sellReversal and sellRevScore >= reversalVeryStrong

// ===== Session clocks: context only =====
f_open(simple string zone, simple int hh, simple int mm) =>
    target = timestamp(zone, year(time, zone), month(time, zone), dayofmonth(time, zone), hh, mm)
    time <= target and time_close > target

tokOpen = barstate.isconfirmed and f_open("Asia/Tokyo", 9, 0)
lonOpen = barstate.isconfirmed and f_open("Europe/London", 8, 0)
nyOpen = barstate.isconfirmed and f_open("America/New_York", 9, 30)

// ===== Tooltip details =====
buyDetails = f_mark(localBull, "EMA 9/21 haussiere") + f_mark(htfBull, "HTF haussier") + f_mark(buyVwap, "Prix au-dessus VWAP") + f_mark(buyMomentum, "Momentum RSI/MACD") + f_mark(volumeOk, "Volume relatif >= " + str.tostring(relVolMin)) + f_mark(volumeHigh, "Volume eleve " + str.tostring(relVol, "#.00") + "x") + f_mark(expansion, "Expansion ATR") + f_mark(higherHigh, "Higher High") + f_mark(higherLow, "Higher Low") + f_mark(bullBOS, "BOS haussier") + f_mark(bullFvg, "FVG haussier") + f_mark(bullEngulf, "Bullish engulfing") + f_mark(bullHammer, "Hammer") + f_mark(bullPin, "Bull pin bar") + f_mark(bullReject, "Rejet EMA") + f_mark(displacementUp, "Displacement haussier")
sellDetails = f_mark(localBear, "EMA 9/21 baissiere") + f_mark(htfBear, "HTF baissier") + f_mark(sellVwap, "Prix sous VWAP") + f_mark(sellMomentum, "Momentum RSI/MACD") + f_mark(volumeOk, "Volume relatif >= " + str.tostring(relVolMin)) + f_mark(volumeHigh, "Volume eleve " + str.tostring(relVol, "#.00") + "x") + f_mark(expansion, "Expansion ATR") + f_mark(lowerHigh, "Lower High") + f_mark(lowerLow, "Lower Low") + f_mark(bearBOS, "BOS baissier") + f_mark(bearFvg, "FVG baissier") + f_mark(bearEngulf, "Bearish engulfing") + f_mark(bearShootingStar, "Shooting star") + f_mark(bearPin, "Bear pin bar") + f_mark(bearReject, "Rejet EMA") + f_mark(displacementDown, "Displacement baissier")

buyRevDetails = f_mark(bullMSS, "MSS haussier") + f_mark(recentRsiUp, "RSI sorti de survente") + f_mark(recentBullDiv, "Divergence RSI haussiere recente") + f_mark(bullPatternContext, "Pattern bougie haussier confirme") + f_mark(bullAbsorption, "Absorption haussiere potentielle") + f_mark(volumeHigh, "Volume eleve " + str.tostring(relVol, "#.00") + "x") + f_mark(volumeExtreme, "Volume exceptionnel") + f_mark(close > emaFast, "Reprise EMA rapide") + f_mark(buyVwap, "Prix au-dessus VWAP") + f_mark(htfBull, "HTF haussier")
sellRevDetails = f_mark(bearMSS, "MSS baissier") + f_mark(recentRsiDown, "RSI sorti de surachat") + f_mark(recentBearDiv, "Divergence RSI baissiere recente") + f_mark(bearPatternContext, "Pattern bougie baissier confirme") + f_mark(bearAbsorption, "Absorption baissiere potentielle") + f_mark(volumeHigh, "Volume eleve " + str.tostring(relVol, "#.00") + "x") + f_mark(volumeExtreme, "Volume exceptionnel") + f_mark(close < emaFast, "Perte EMA rapide") + f_mark(sellVwap, "Prix sous VWAP") + f_mark(htfBear, "HTF baissier")

// ===== Guides =====
plot(showGuides ? emaFast : na, "EMA 9", color=color.new(color.blue, 40))
plot(showGuides ? emaSlow : na, "EMA 21", color=color.new(color.orange, 40))
plot(showGuides ? vwap : na, "VWAP", color=color.new(color.purple, 40))

// ===== Existing context markers only; no new candle/volume markers =====
if showContext and rsiExitUp
    label.new(bar_index, low, "R↑", style=label.style_label_up, color=color.new(color.green, 100), textcolor=color.lime, size=size.tiny, tooltip=showTooltips ? "RSI recovery\nLe RSI repasse au-dessus de 30 apres survente. Contexte uniquement, pas un BUY automatique." : "")

if showContext and rsiExitDown
    label.new(bar_index, high, "R↓", style=label.style_label_down, color=color.new(color.red, 100), textcolor=color.red, size=size.tiny, tooltip=showTooltips ? "RSI reversal\nLe RSI repasse sous 70 apres surachat. Contexte uniquement, pas un SELL automatique." : "")

if showContext and bullDiv
    label.new(bar_index, low, "DIV↑", style=label.style_label_up, color=color.new(color.aqua, 100), textcolor=color.aqua, size=size.tiny, tooltip=showTooltips ? "Divergence RSI haussiere\nLe prix fait un nouveau pivot bas tandis que le RSI fait un pivot plus haut. Signal de contexte." : "")

if showContext and bearDiv
    label.new(bar_index, high, "DIV↓", style=label.style_label_down, color=color.new(color.orange, 100), textcolor=color.orange, size=size.tiny, tooltip=showTooltips ? "Divergence RSI baissiere\nLe prix fait un nouveau pivot haut tandis que le RSI fait un pivot plus bas. Signal de contexte." : "")

if showContext and bullMSS
    label.new(bar_index, low, "MSS↑", style=label.style_label_up, color=color.new(color.aqua, 15), textcolor=color.black, size=size.tiny, tooltip=showTooltips ? "Market Structure Shift haussier\nCassure de structure baissiere avec displacement et volume." : "")

if showContext and bearMSS
    label.new(bar_index, high, "MSS↓", style=label.style_label_down, color=color.new(color.orange, 15), textcolor=color.black, size=size.tiny, tooltip=showTooltips ? "Market Structure Shift baissier\nCassure de structure haussiere avec displacement et volume." : "")

// ===== Main signals with explanations =====
if buyStrong
    label.new(bar_index, low, "B+", style=label.style_label_up, color=color.new(color.green, 75), textcolor=color.lime, size=size.tiny, tooltip=f_tip("BUY fort", buyScore, buyDetails))

if buyVeryStrong
    label.new(bar_index, low, "B++", style=label.style_label_up, color=color.new(color.green, 55), textcolor=color.lime, size=size.small, tooltip=f_tip("BUY tres fort", buyScore, buyDetails))

if sellStrong
    label.new(bar_index, high, "S+", style=label.style_label_down, color=color.new(color.red, 75), textcolor=color.red, size=size.tiny, tooltip=f_tip("SELL fort", sellScore, sellDetails))

if sellVeryStrong
    label.new(bar_index, high, "S++", style=label.style_label_down, color=color.new(color.red, 55), textcolor=color.red, size=size.small, tooltip=f_tip("SELL tres fort", sellScore, sellDetails))

if buyRevStrong
    label.new(bar_index, low, "BR", style=label.style_label_up, color=color.new(color.green, 35), textcolor=color.white, size=size.tiny, tooltip=f_tip("BUY reversal", buyRevScore, buyRevDetails))

if buyRevVeryStrong
    label.new(bar_index, low, "BR+", style=label.style_label_up, color=color.new(color.green, 15), textcolor=color.white, size=size.small, tooltip=f_tip("BUY reversal tres fort", buyRevScore, buyRevDetails))

if sellRevStrong
    label.new(bar_index, high, "SR", style=label.style_label_down, color=color.new(color.maroon, 35), textcolor=color.white, size=size.tiny, tooltip=f_tip("SELL reversal", sellRevScore, sellRevDetails))

if sellRevVeryStrong
    label.new(bar_index, high, "SR+", style=label.style_label_down, color=color.new(color.maroon, 15), textcolor=color.white, size=size.small, tooltip=f_tip("SELL reversal tres fort", sellRevScore, sellRevDetails))

// ===== Sessions: context only =====
plotshape(showSessions and tokOpen, title="Tokyo open", style=shape.circle, location=location.bottom, size=size.tiny, color=color.aqua, text="TOK")
plotshape(showSessions and lonOpen, title="London open", style=shape.circle, location=location.bottom, size=size.tiny, color=color.orange, text="LON")
plotshape(showSessions and nyOpen, title="New York open", style=shape.circle, location=location.bottom, size=size.tiny, color=color.yellow, text="NY")

// ===== Alerts =====
alertcondition(buyStrong or buyVeryStrong or buyRevStrong or buyRevVeryStrong, title="Nykuto BUY V10", message="Nykuto V10 BUY confluence confirmed. Research signal, not an order.")
alertcondition(sellStrong or sellVeryStrong or sellRevStrong or sellRevVeryStrong, title="Nykuto SELL V10", message="Nykuto V10 SELL confluence confirmed. Research signal, not an order.")
alertcondition(bullMSS, title="Nykuto MSS up V10", message="Nykuto V10 bullish MSS context.")
alertcondition(bearMSS, title="Nykuto MSS down V10", message="Nykuto V10 bearish MSS context.")
